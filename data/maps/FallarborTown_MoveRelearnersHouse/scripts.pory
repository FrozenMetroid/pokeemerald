mapscripts FallarborTown_MoveRelearnersHouse_MapScripts {}

script FallarborTown_MoveRelearnersHouse_EventScript_MoveRelearner {
	lockall
	applywaitmovement(LOCALID_MOVE_RELEARNER, Common_Movement_FacePlayer)
	msgbox(
	"Did you know?
	POKéMON can learn moves they forgot.
	
	Once they've learned a move,
	they can relearn it at any time.
	
	Isn't that neat?$")
	release
	end
}
